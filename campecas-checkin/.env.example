# URL e chave pública (anon/publishable) do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica

# Chave de serviço — SOMENTE no servidor. Usada apenas na tela "Equipe"
# para criar/desativar funcionários. Nunca exponha com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-de-servico

# URL pública do sistema (usada em links e cabeçalhos de segurança)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
