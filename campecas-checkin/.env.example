# URL e chave pública (anon/publishable) do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica

# Chave do servidor para ler o laudo público (/laudo/[token]). SOMENTE no servidor.
# O valor está em private.app_secrets (name = 'report_server_key') no banco:
#   select value from private.app_secrets where name = 'report_server_key';
REPORT_SERVER_KEY=valor-da-tabela-private.app_secrets

# URL pública do sistema (usada em links e cabeçalhos de segurança)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
